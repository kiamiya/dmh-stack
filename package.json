{
  "name": "dmh-stack",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck && tsc --noEmit -p scripts/tsconfig.json",
    "test": "turbo run test",
    "check-env": "tsx --env-file=.env.local scripts/check-env.ts",
    "check-pappers": "tsx --env-file=.env.local scripts/check-pappers.ts",
    "import-pharow": "tsx --env-file=.env.local scripts/import-pharow.ts",
    "test-attribution": "tsx --env-file=.env.local scripts/test-attribution.ts",
    "sync-lemlist": "tsx --env-file=.env.local scripts/sync-lemlist.ts"
  },
  "dependencies": {
    "@dmh/config": "workspace:*",
    "@dmh/lemlist": "workspace:*",
    "@dmh/pappers": "workspace:*",
    "@dmh/pharow": "workspace:*",
    "@dmh/smartlead": "workspace:*",
    "@supabase/supabase-js": "^2.111.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "supabase": "^2.109.1",
    "tsx": "^4.19.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
